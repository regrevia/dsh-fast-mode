{
  "name": "dsh-fast-mode",
  "version": "0.8.0",
  "description": "DeepSeek Harness fast mode: a lightning switch in the composer, gear-based adaptive reasoning effort plus parallel tool batching, with a built-in speed/token benchmark. Provider-agnostic, one dependency (@deepseek-ai/schemastery).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/dsh-fast-mode.git"
  },
  "homepage": "https://github.com/regrevia/dsh-fast-mode#readme",
  "bugs": {
    "url": "https://github.com/regrevia/dsh-fast-mode/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./effort": "./src/effort.js",
    "./guidance": "./src/guidance.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./metrics": "./src/metrics.js",
    "./benchmark": "./src/benchmark.js",
    "./state": "./src/state.js"
  },
  "files": [
    "index.js",
    "client.js",
    "src/",
    "bin/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "BENCHMARK.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "fast-mode",
    "reasoning-effort",
    "parallel-tools",
    "latency",
    "deepseek"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "report": "node bin/report.mjs",
    "experiment": "node bin/experiment.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "remote",
        "remote.settings"
      ],
      "immediately": true
    }
  },
  "author": "regrevia",
  "icon": "./icon.png",
  "bin": {
    "dsh-fast-mode-experiment": "./bin/experiment.mjs",
    "dsh-fast-mode-report": "./bin/report.mjs"
  }
}
