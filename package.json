{
  "name": "dsh-fast-mode",
  "version": "1.7.34",
  "description": "DeepSeek Harness’s own fast mode: the same model, half the output, up to twice as fast. Switches combine freely and stay prompt-side — never changes the model, reasoning effort, or the request body. Best measured 0.505x wall clock, −42% output tokens, 438/438 checks green; a few task shapes are slower, see BENCHMARK.md.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/dsh-fast-mode.git"
  },
  "homepage": "https://github.com/regrevia/dsh-fast-mode#readme",
  "bugs": {
    "url": "https://github.com/regrevia/dsh-fast-mode/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./effort": "./src/effort.js",
    "./guidance": "./src/guidance.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./metrics": "./src/metrics.js",
    "./benchmark": "./src/benchmark.js",
    "./state": "./src/state.js",
    "./stallguard": "./src/stallguard.js",
    "./peers": "./src/peers.js",
    "./parallel": "./src/parallel.js"
  },
  "files": [
    "audit/",
    "skills/",
    "index.js",
    "client.js",
    "src/",
    "bin/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "BENCHMARK.md",
    "bench/block_score.py",
    "bench/mechanism.py",
    "bench/textshare.py",
    "bench/reminders.py",
    "bench/patchshare.py",
    "bench/ablate.py",
    "bench/turns.py",
    "bench/replay.mjs",
    "bench/soak.mjs",
    "docs/",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "fast-mode",
    "tool-fanout",
    "adaptive-parallel",
    "latency",
    "deepseek"
  ],
  "dependencies": {},
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "scripts": {
    "test": "node --test",
    "report": "node bin/report.mjs",
    "experiment": "node bin/experiment.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "remote",
        "remote.settings"
      ],
      "immediately": true
    }
  },
  "author": {
    "name": "regrevia",
    "url": "https://github.com/regrevia"
  },
  "icon": "./icon.png",
  "bin": {
    "dsh-fast-mode-experiment": "./bin/experiment.mjs",
    "dsh-fast-mode-report": "./bin/report.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.5-rc.1 <4.0.0-0 || >=4.0.0-rc.1 <5.0.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
