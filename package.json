{
  "name": "dsh-fast-mode",
  "version": "0.4.0",
  "description": "DeepSeek Harness fast mode: gear-based adaptive reasoning effort plus parallel tool batching. Zero dependencies, provider-agnostic, one host plugin.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regrevia/dsh-fast-mode.git"
  },
  "homepage": "https://github.com/regrevia/dsh-fast-mode#readme",
  "bugs": {
    "url": "https://github.com/regrevia/dsh-fast-mode/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./effort": "./src/effort.js",
    "./guidance": "./src/guidance.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "fast-mode",
    "reasoning-effort",
